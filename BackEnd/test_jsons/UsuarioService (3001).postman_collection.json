        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Funcionario Postman\",\n  \"correo\": \"funcionario.postman.{{$timestamp}}@vales.cl\",\n  \"rol\": \"Funcionario\",\n  \"activo\": true\n}",
